<UserControl
	x:Class="ValGrid.Views.Info"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:p="clr-namespace:ValGrid.Properties"
	xmlns:viewModels="clr-namespace:ValGrid.ViewModels"
	xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
	d:DesignHeight="754"
	d:DesignWidth="1536"
	UseLayoutRounding="True"
	mc:Ignorable="d"
	d:DataContext="{d:DesignInstance Type=viewModels:InfoViewModel}">
	<UserControl.Resources>
		<Style TargetType="ToolTip">
			<Setter Property="Background" Value="#32e2b2" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="Black" />
			<Setter Property="FontFamily" Value="{StaticResource Nunito}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="ToolTipService.InitialShowDelay" Value="0" />
			<Setter Property="HasDropShadow" Value="False" />
		</Style>
	</UserControl.Resources>
	<UserControl.Triggers>
		<EventTrigger RoutedEvent="Loaded">
			<BeginStoryboard>
				<Storyboard>
					<DoubleAnimation
						Storyboard.TargetProperty="Opacity"
						From="0.0" To="1.0" Duration="0:0:1" />
				</Storyboard>
			</BeginStoryboard>
		</EventTrigger>
	</UserControl.Triggers>

	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="60" />
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<Grid Grid.ColumnSpan="3">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="60" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="60" />
			</Grid.ColumnDefinitions>

			<Button
				x:Name="InfoSettingsBtn"
				Grid.Column="0" Cursor="Hand"
				ToolTipService.InitialShowDelay="0"
				Command="{Binding DataContext.NavigateSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				Template="{StaticResource ButtonTemplate}">

				<fa:ImageAwesome PrimaryColor="#007EF9" Icon="Solid_Gear" Margin="10" />
			</Button>

			<Button
				x:Name="InfoHomeBtn"
				Grid.Column="1" Cursor="Hand"
				ToolTipService.InitialShowDelay="0"
				HorizontalAlignment="Center"
				MinWidth="160" Height="46" Padding="20,0"
				Command="{Binding DataContext.NavigateHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				Template="{StaticResource ButtonTemplate}">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
					<fa:ImageAwesome PrimaryColor="#007EF9" Icon="Solid_AngleLeft" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
					<TextBlock
						x:Name="InfoHomeBtnText"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						FontFamily="{StaticResource Nunito}"
						FontWeight="Bold"
						FontSize="16"
						Foreground="#007EF9"
						Text="Ana Sayfa" />
				</StackPanel>
			</Button>

			<fa:ImageAwesome Grid.Column="2" PrimaryColor="#007EF9" Icon="Solid_Info" Margin="10" />

		</Grid>

		<StackPanel
			Margin="5"
			Grid.Row="1"
			Grid.Column="0"
			Grid.ColumnSpan="3"
			HorizontalAlignment="Center"
			VerticalAlignment="Center">
			<Button Background="Transparent"
			        BorderThickness="0"
			        Height="120"
			        Cursor="Hand"
			        HorizontalAlignment="Center"
			        RenderOptions.BitmapScalingMode="HighQuality"
			        Click="ImageClickAsync"
			        Tag="https://github.com/Efeumut0/ValGrid">
				<Image Source="/Assets/logo.png" />
				<Button.Effect>
					<DropShadowEffect BlurRadius="5" ShadowDepth="3" />
				</Button.Effect>
			</Button>
			<TextBlock
				HorizontalAlignment="Center"
				FontSize="45"
				FontWeight="SemiBold"
				Foreground="White"
				FontFamily="{StaticResource Nunito}"
				TextWrapping="Wrap">
				ValGrid
			</TextBlock>
			<TextBlock
				x:Name="InfoAppSubtitleText"
				HorizontalAlignment="Center"
				FontSize="23"
				FontWeight="DemiBold"
				FontFamily="{StaticResource Nunito}"
				Foreground="#32e2b2"
				Text="Valorant Canlı Maç &amp; Mağaza Asistanı"
				TextWrapping="Wrap" />

			<!-- App Version Badge -->
			<Border HorizontalAlignment="Center" Margin="0,14,0,0" Padding="12,4"
			        Background="#181e33" CornerRadius="8" BorderBrush="#2e3a58" BorderThickness="1">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="v" FontFamily="{StaticResource Nunito}" FontSize="13" FontWeight="Bold" Foreground="#8e9bb5" VerticalAlignment="Center" />
					<TextBlock x:Name="InfoVersionText" Text="1.4.07" FontFamily="{StaticResource Nunito}" FontSize="13" FontWeight="Bold" Foreground="#ffd700" VerticalAlignment="Center" />
				</StackPanel>
			</Border>
		</StackPanel>

