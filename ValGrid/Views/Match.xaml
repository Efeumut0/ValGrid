<UserControl x:Class="ValGrid.Views.Match"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ValGrid.Controls"
             xmlns:viewmodels="clr-namespace:ValGrid.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converters="clr-namespace:ValGrid.Converters"
             xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
             xmlns:p="clr-namespace:ValGrid.Properties"
             d:DataContext="{d:DesignInstance Type=viewmodels:MatchViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="754"
             d:DesignWidth="1536">
	<i:Interaction.Triggers>
		<i:EventTrigger EventName="Loaded">
			<i:InvokeCommandAction Command="{Binding PassiveLoadCheckCommand}" />
		</i:EventTrigger>
		<i:EventTrigger EventName="Unloaded">
			<i:InvokeCommandAction Command="{Binding UnloadViewCommand}" />
		</i:EventTrigger>
	</i:Interaction.Triggers>
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
		<converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
	</UserControl.Resources>
	<UserControl.Triggers>
		<EventTrigger RoutedEvent="Loaded">
			<BeginStoryboard>
				<Storyboard>
					<DoubleAnimation
						Storyboard.TargetProperty="Opacity"
						From="0.0" To="1.0" Duration="0:0:1" />
				</Storyboard>
			</BeginStoryboard>
		</EventTrigger>
	</UserControl.Triggers>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="70" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="70" />
				<ColumnDefinition Width="70" />
				<ColumnDefinition Width="70" />
				<ColumnDefinition Width="70" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Button
				Grid.Column="0"
				Margin="7" x:Name="GoHome"
				ToolTipService.InitialShowDelay="0"
				Command="{Binding DataContext.NavigateHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				Template="{StaticResource ButtonTemplate}">

				<fa:ImageAwesome PrimaryColor="#007EF9" Icon="Solid_AngleLeft" Margin="10" />
			</Button>
			<Button
				x:Name="MatchSettingsBtn"
				Grid.Column="1"
				Margin="7"
				ToolTipService.InitialShowDelay="0"
				Command="{Binding DataContext.NavigateSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				Template="{StaticResource ButtonTemplate}">

				<fa:ImageAwesome PrimaryColor="#007EF9" Icon="Solid_Gear" Margin="10" />
			</Button>
			<Button
				IsEnabled="{Binding Path=Overlay.IsBusy, Converter={StaticResource InverseBooleanConverter}}"
				Grid.Column="2"
				Margin="7"
				Command="{Binding GetMatchInfoCommand}"
				Template="{StaticResource ButtonTemplate}">
				<fa:ImageAwesome PrimaryColor="#007EF9" Icon="Solid_Rotate" Margin="10" />
			</Button>
			<ToggleButton
				Grid.Column="3" Margin="7"
				IsChecked="{Binding IsPaused, Mode=TwoWay}"
				Template="{StaticResource ToggleButtonTemplate}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="Checked">
						<i:InvokeCommandAction Command="{Binding Path=StopPassiveLoadAsyncCommand}" />
					</i:EventTrigger>
					<i:EventTrigger EventName="Unchecked">
						<i:InvokeCommandAction Command="{Binding Path=PassiveLoadAsyncCommand}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
				<fa:ImageAwesome PrimaryColor="#007EF9" Icon="Solid_Pause" Margin="10" />
			</ToggleButton>

			<TextBlock x:Name="MatchRefreshingInLabel" Margin="10" Grid.Column="4"
			           FontSize="20"
			           VerticalAlignment="Center"
			           FontWeight="Normal"
			           Foreground="White"
			           FontFamily="{StaticResource Nunito}"
			           Text="Yenileniyor:" />
			<TextBlock Margin="10"
			           FontSize="20" Grid.Column="5"
			           FontFamily="{StaticResource Nunito}"
			           VerticalAlignment="Center"
			           FontWeight="Normal"
			           Foreground="#007EF9"
			           Text="{Binding RefreshTime}" />

			<!-- Left Badges: Match Inventory Value + Server & Connection Details -->
			<StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
				<!-- Match Inventory Value Badge (Total VP & Dynamic TL) -->
				<Border
					Margin="15,7,7,7" Padding="12,6"
					Background="#141829" CornerRadius="10"
					BorderBrush="#313958" BorderThickness="1.2"
					Visibility="{Binding Path=Match.LobbyValueVisibility, FallbackValue=Collapsed}">
					<Border.Effect>
						<DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="Black" Opacity="0.5" />
					</Border.Effect>
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<fa:ImageAwesome Icon="Solid_Gem" PrimaryColor="#38bdf8" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,9,0" />
						<StackPanel VerticalAlignment="Center">
							<StackPanel Orientation="Horizontal">
								<TextBlock x:Name="MatchValueLabelText" Text="Maç Değeri: " FontFamily="{StaticResource Nunito}" FontSize="13"
								           FontWeight="SemiBold" Foreground="#8e9bb5" VerticalAlignment="Center" />
								<TextBlock Text="{Binding Path=Match.LobbyTotalValueVpText, FallbackValue='0 VP'}"
								           FontFamily="{StaticResource Nunito}" FontSize="14" FontWeight="Bold"
								           Foreground="#ffd700" VerticalAlignment="Center" />
								<TextBlock Text=" (" FontFamily="{StaticResource Nunito}" FontSize="12"
								           Foreground="#6f7b98" VerticalAlignment="Center" />
								<TextBlock Text="{Binding Path=Match.LobbyTotalValueTlText, FallbackValue='0 TL'}"
								           FontFamily="{StaticResource Nunito}" FontSize="13" FontWeight="SemiBold"
								           Foreground="#32e2b2" VerticalAlignment="Center" />
								<TextBlock Text=")" FontFamily="{StaticResource Nunito}" FontSize="12"
								           Foreground="#6f7b98" VerticalAlignment="Center" />
								<TextBlock x:Name="MatchEquippedOnlyText" Text=" (SADECE TAKILI OLANLAR)" FontFamily="{StaticResource Nunito}" FontSize="12"
								           FontWeight="ExtraBold" Foreground="#f59e0b" VerticalAlignment="Center" Margin="5,0,0,0" />
							</StackPanel>
							<StackPanel Orientation="Horizontal" Margin="0,1,0,0">
								<TextBlock Text="{Binding Path=Match.TeamBlueLabel, FallbackValue='Sol Takım: '}" FontFamily="{StaticResource Nunito}" FontSize="11"
								           Foreground="#5b92e5" VerticalAlignment="Center" />
								<TextBlock Text="{Binding Path=Match.TeamBlueValueCombinedText, FallbackValue='0 VP (~0 TL)'}"
								           FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="SemiBold"
								           Foreground="#d1d5db" VerticalAlignment="Center" />
								<TextBlock Text="   |   " FontFamily="{StaticResource Nunito}" FontSize="11"
								           Foreground="#6f7b98" VerticalAlignment="Center" />
								<TextBlock Text="{Binding Path=Match.TeamRedLabel, FallbackValue='Sağ Takım: '}" FontFamily="{StaticResource Nunito}" FontSize="11"
								           Foreground="#e55b5b" VerticalAlignment="Center" />
								<TextBlock Text="{Binding Path=Match.TeamRedValueCombinedText, FallbackValue='0 VP (~0 TL)'}"
								           FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="SemiBold"
								           Foreground="#d1d5db" VerticalAlignment="Center" />
							</StackPanel>
							<!-- Team Inventory Comparison Ratio Bar -->
							<Grid Margin="0,5,0,1" Height="5" MaxWidth="320" HorizontalAlignment="Stretch"
							      Visibility="{Binding Path=Match.TeamRatioVisibility, FallbackValue=Collapsed}"
							      ToolTip="{Binding Path=Match.TeamRatioTooltip}"
							      ToolTipService.InitialShowDelay="0">
								<!-- Red Base (Red Team) -->
								<Border Background="#e55b5b" CornerRadius="2.5" />
								<!-- Blue Fill (Blue Team Proportion) -->
								<ProgressBar Value="{Binding Path=Match.TeamBluePercent, FallbackValue=50}" Minimum="0" Maximum="100"
								             Height="5" BorderThickness="0" Background="Transparent" Foreground="#5b92e5">
									<ProgressBar.Resources>
										<Style TargetType="ProgressBar">
											<Setter Property="Template">
												<Setter.Value>
													<ControlTemplate TargetType="ProgressBar">
														<Grid x:Name="Root">
															<Border x:Name="PART_Track" Background="Transparent" CornerRadius="2.5" ClipToBounds="True">
																<Border x:Name="PART_Indicator" Background="#5b92e5" HorizontalAlignment="Left" CornerRadius="2.5" />
															</Border>
														</Grid>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>
									</ProgressBar.Resources>
								</ProgressBar>
							</Grid>
						</StackPanel>
						<!-- Copy Match Summary Button -->
						<Button x:Name="CopyMatchSummaryBtn"
						        Click="CopyMatchSummary_Click"
						        MouseRightButtonUp="CopyMatchSummary_RightClick"
						        Margin="12,0,0,0" Padding="6,3"
						        Background="#1f263d" BorderBrush="#3c476d" BorderThickness="1"
						        Cursor="Hand" VerticalAlignment="Center"
						        ToolTip="Sol Tık: Maç Sonu Mesajını Kopyala&#x0a;Sağ Tık: Maç Başlangıç Mesajını Kopyala"
						        ToolTipService.InitialShowDelay="0">
							<Button.Resources>
								<Style TargetType="Border">
									<Setter Property="CornerRadius" Value="6" />
								</Style>
							</Button.Resources>
							<TextBlock x:Name="CopyMatchIcon" Text="📋" FontSize="13" VerticalAlignment="Center" />
						</Button>
					</StackPanel>
				</Border>

				<!-- Match Leaderboard Badge (Sırasıyla Liderlik) -->
				<Border
					x:Name="LeaderboardBadge"
					Margin="7,7,7,7" Padding="12,6"
					Background="#141829" CornerRadius="10"
					BorderBrush="#313958" BorderThickness="1.2"
					Visibility="{Binding Path=Match.LeaderboardVisibility, FallbackValue=Collapsed}"
					ToolTip="{Binding Path=Match.LeaderboardTooltip}"
					ToolTipService.InitialShowDelay="0"
					MouseRightButtonUp="CopyLeaderboard_RightClick">
					<Border.Effect>
						<DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="Black" Opacity="0.5" />
					</Border.Effect>
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<fa:ImageAwesome Icon="Solid_Crown" PrimaryColor="#ffd700" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,9,0" />
						<StackPanel VerticalAlignment="Center">
							<TextBlock x:Name="MatchLeaderboardTitleText" Text="Sırasıyla Liderlik" FontFamily="{StaticResource Nunito}" FontSize="13"
							           FontWeight="Bold" Foreground="#ffd700" VerticalAlignment="Center" />
							<TextBlock Text="{Binding Path=Match.LeaderboardTopSummary, FallbackValue='Liderlik bilgisi bekleniyor...'}"
							           FontFamily="{StaticResource Nunito}" FontSize="11.5" FontWeight="SemiBold"
							           Foreground="#cbd5e1" VerticalAlignment="Center" Margin="0,1,0,0"
							           TextTrimming="CharacterEllipsis" MaxWidth="320" />
						</StackPanel>
						<!-- Copy Leaderboard Button -->
						<Button x:Name="CopyLeaderboardBtn"
						        Click="CopyLeaderboard_Click"
						        MouseRightButtonUp="CopyLeaderboard_RightClick"
						        Margin="12,0,0,0" Padding="6,3"
						        Background="#1f263d" BorderBrush="#3c476d" BorderThickness="1"
						        Cursor="Hand" VerticalAlignment="Center"
						        ToolTip="Sol Tık: Liderlik Metnini Kopyala (Tek Satır)&#x0a;Sağ Tık: Liderlik Metnini Kopyala (Alt Alta Liste)"
						        ToolTipService.InitialShowDelay="0">
							<Button.Resources>
								<Style TargetType="Border">
									<Setter Property="CornerRadius" Value="6" />
								</Style>
							</Button.Resources>
							<TextBlock x:Name="CopyLeaderboardIcon" Text="📋" FontSize="13" Foreground="#ffd700" VerticalAlignment="Center" />
						</Button>
					</StackPanel>
				</Border>

				<!-- Blacklist Alert Badge (Kara Liste / Tehdit Uyarısı) -->
				<Border
					x:Name="BlacklistAlertBadge"
					Margin="7,7,7,7" Padding="12,6"
					Background="#2a1215" CornerRadius="10"
					BorderBrush="#ef4444" BorderThickness="1.2"
					Visibility="{Binding Path=Match.BlacklistAlertVisibility, FallbackValue=Collapsed}"
					ToolTip="{Binding Path=Match.BlacklistAlertTooltip}"
					ToolTipService.InitialShowDelay="0">
					<Border.Effect>
						<DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#ef4444" Opacity="0.4" />
					</Border.Effect>
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<fa:ImageAwesome Icon="Solid_Ban" PrimaryColor="#ef4444" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,9,0" />
						<StackPanel VerticalAlignment="Center">
							<TextBlock x:Name="MatchBlacklistAlertTitleText" Text="KARA LİSTE UYARISI" FontFamily="{StaticResource Nunito}" FontSize="12.5"
							           FontWeight="Bold" Foreground="#f87171" VerticalAlignment="Center" />
							<TextBlock Text="{Binding Path=Match.BlacklistAlertText, FallbackValue='Lobide engellenmiş oyuncu var!'}"
							           FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="SemiBold"
							           Foreground="#fca5a5" VerticalAlignment="Center" Margin="0,1,0,0"
							           TextTrimming="CharacterEllipsis" MaxWidth="260" />
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- Server & Connection Details Badge -->
				<Border
					Margin="7,7,7,7" Padding="12,6"
					Background="#141829" CornerRadius="10"
					BorderBrush="#313958" BorderThickness="1.2"
					Visibility="{Binding Path=Match.ServerInfoVisibility, FallbackValue=Collapsed}"
					ToolTip="{Binding Path=Match.ServerTooltip}"
					ToolTipService.InitialShowDelay="0"
					MouseRightButtonUp="CopyServerInfo_RightClick">
					<Border.Effect>
						<DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="Black" Opacity="0.5" />
					</Border.Effect>
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<fa:ImageAwesome Icon="Solid_Globe" PrimaryColor="#38bdf8" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
						<StackPanel VerticalAlignment="Center">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="{Binding Path=Match.ServerRegion, FallbackValue='Sunucu'}"
								           FontFamily="{StaticResource Nunito}" FontSize="13" FontWeight="Bold"
								           Foreground="White" VerticalAlignment="Center" />
								<!-- Ping Badge -->
								<Border Background="#1b2138" CornerRadius="6" Padding="6,1" Margin="8,0,0,0"
								        BorderBrush="{Binding Path=Match.ServerPingColor, FallbackValue='#32e2b2'}" BorderThickness="1"
								        VerticalAlignment="Center">
									<StackPanel Orientation="Horizontal">
										<fa:ImageAwesome Icon="Solid_Signal" PrimaryColor="{Binding Path=Match.ServerPingColor, FallbackValue='#32e2b2'}" Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center" />
										<TextBlock Text="{Binding Path=Match.ServerPing, FallbackValue='-- ms'}"
										           FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="Bold"
										           Foreground="{Binding Path=Match.ServerPingColor, FallbackValue='#32e2b2'}" VerticalAlignment="Center" />
									</StackPanel>
								</Border>
							</StackPanel>
							<StackPanel Orientation="Horizontal" Margin="0,1,0,0">
								<TextBlock Text="IP: " FontFamily="{StaticResource Nunito}" FontSize="11"
								           Foreground="#8e9bb5" VerticalAlignment="Center" />
								<TextBlock Text="{Binding Path=Match.ServerIpPort, FallbackValue='--'}"
								           FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="SemiBold"
								           Foreground="#38bdf8" VerticalAlignment="Center" />
								<TextBlock Text="  •  Anahtar: " FontFamily="{StaticResource Nunito}" FontSize="11"
								           Foreground="#6f7b98" VerticalAlignment="Center"
								           Visibility="{Binding Path=Match.PlayerKeyVisibility, FallbackValue=Collapsed}" />
								<TextBlock Text="{Binding Path=Match.PlayerKeyMasked, FallbackValue='--'}"
								           FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="SemiBold"
								           Foreground="#a855f7" VerticalAlignment="Center"
								           Visibility="{Binding Path=Match.PlayerKeyVisibility, FallbackValue=Collapsed}" />
							</StackPanel>
						</StackPanel>
						<!-- Copy Server Info Button -->
						<Button x:Name="CopyServerInfoBtn"
						        Click="CopyServerInfo_Click"
						        MouseRightButtonUp="CopyServerInfo_RightClick"
						        Margin="10,0,0,0" Padding="6,3"
						        Background="#1f263d" BorderBrush="#3c476d" BorderThickness="1"
						        Cursor="Hand" VerticalAlignment="Center"
						        ToolTip="Sol Tık: Alt Alta Kopyala&#x0a;Sağ Tık: Tek Satırda Kopyala"
						        ToolTipService.InitialShowDelay="0">
							<Button.Resources>
								<Style TargetType="Border">
									<Setter Property="CornerRadius" Value="6" />
								</Style>
							</Button.Resources>
							<TextBlock x:Name="CopyServerIcon" Text="📋" FontSize="13" VerticalAlignment="Center" />
						</Button>
					</StackPanel>
				</Border>
			</StackPanel>

			<Border
				Grid.Column="7" HorizontalAlignment="Right"
				Margin="6,7"
				CornerRadius="10">

				<Border.Effect>
					<DropShadowEffect BlurRadius="5" ShadowDepth="3" />
				</Border.Effect>
				<StackPanel Orientation="Horizontal">
					<Image Height="30px" Width="30px" Source="{Binding Path=Match.GameModeImage}" />
					<TextBlock FontFamily="{StaticResource Nunito}" FontSize="25" FontWeight="SemiBold" Margin="10"
					           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
					           Text="{Binding Path=Match.GameMode}" />
				</StackPanel>


			</Border>

			<Border
				Grid.Column="8" HorizontalAlignment="Right" MinWidth="220"
				Margin="6,7"
				CornerRadius="10">
				<Border.Effect>
					<DropShadowEffect BlurRadius="5" ShadowDepth="3" />
				</Border.Effect>

				<Border.Background>
					<ImageBrush Stretch="UniformToFill" ImageSource="{Binding Path=Match.MapImage}" />
				</Border.Background>

				<TextBlock FontFamily="{StaticResource Nunito}" FontSize="25" FontWeight="Bold" Margin="10"
				           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
				           Text="{Binding Path=Match.Map}" />


			</Border>

			<!-- Player Directory & List Button -->
			<Button
				x:Name="MatchPlayerListBtn"
				Grid.Column="9"
				Margin="6,7"
				Height="56"
				Click="OpenPlayerList_Click"
				Template="{StaticResource ButtonTemplate}"
				ToolTipService.InitialShowDelay="0"
				Cursor="Hand">
				<StackPanel Orientation="Horizontal" Margin="14,0">
					<fa:ImageAwesome Icon="Solid_Users" PrimaryColor="#32e2b2" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
					<TextBlock x:Name="MatchPlayerListText" Text="Liste" FontFamily="{StaticResource Nunito}" FontSize="16" FontWeight="Bold"
					           Foreground="#32e2b2" VerticalAlignment="Center" />
				</StackPanel>
			</Button>

			<!-- Career & Match History Button in Top Right -->
			<Button
				x:Name="MatchCareerBtn"
				Grid.Column="10"
				Margin="6,7,12,7"
				Height="56"
				Click="OpenCareer_Click"
				Template="{StaticResource ButtonTemplate}"
				ToolTipService.InitialShowDelay="0"
				Cursor="Hand">
				<StackPanel Orientation="Horizontal" Margin="14,0">
					<fa:ImageAwesome Icon="Solid_Scroll" PrimaryColor="#007EF9" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
					<TextBlock x:Name="MatchCareerText" Text="Kariyer" FontFamily="{StaticResource Nunito}" FontSize="16" FontWeight="Bold"
					           Foreground="#007EF9" VerticalAlignment="Center" />
				</StackPanel>
			</Button>

		</Grid>

		<Grid Grid.Row="1" Grid.Column="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<ItemsControl ItemsSource="{Binding LeftPlayerList}" Margin="5">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Columns="1" Rows="{Binding UniformGridRows}" Margin="5" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<controls:PlayerControl
						                        Margin="0 4"
						                        PlayerCell="{Binding}" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<StackPanel Grid.Column="1" Orientation="Horizontal">
				<Separator Width="4" Margin="6 20 6 30"
				           Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="#181E34"
				           BorderThickness="0" />
			</StackPanel>
			<Grid Grid.Column="2" Margin="5">
				<ItemsControl ItemsSource="{Binding RightPlayerList}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<UniformGrid Columns="1" Rows="{Binding UniformGridRows}" Margin="5" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<controls:PlayerControl
							                        Margin="0 4"
							                        PlayerCell="{Binding}" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- Karşı Takım Henüz Açılmadıysa (Ajan Seçimi Aşaması) -->
				<Border Visibility="{Binding IsEnemyPlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
				        Background="#141829" CornerRadius="12" Margin="5,8"
				        BorderBrush="#252d47" BorderThickness="1.5"
				        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
					<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
						<Border Width="60" Height="60" CornerRadius="30" Background="#1e2540"
						        BorderBrush="#384469" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,16">
							<fa:ImageAwesome Icon="Solid_ShieldHalved" PrimaryColor="White" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<TextBlock Text="Ajan Seçimi Aşaması (Pregame)" FontFamily="{StaticResource Nunito}"
						           FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
						<TextBlock Text="Riot kuralı gereği ajan seçiminde rakip takım gizlidir.&#x0a;Oyun başladığı an karşı takımın envanterleri, rankları ve isimleri otomatik yüklenecektir."
						           FontFamily="{StaticResource Nunito}" FontSize="12" Foreground="#8e9bb5"
						           TextAlignment="Center" Margin="0,8,0,14" LineHeight="18" />
						<Border Background="#1f2845" CornerRadius="16" Padding="12,6" HorizontalAlignment="Center"
						        BorderBrush="#32e2b2" BorderThickness="1">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="↻ " FontSize="12" Foreground="#32e2b2" VerticalAlignment="Center" />
								<TextBlock Text="Oyun başlangıcı bekleniyor (Hızlı Kontrol)..."
								           FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="SemiBold"
								           Foreground="#32e2b2" VerticalAlignment="Center" />
							</StackPanel>
						</Border>
					</StackPanel>
				</Border>
			</Grid>

		</Grid>
		<controls:OverlayControl Grid.Row="1" Grid.Column="0"
		                         Overlay="{Binding Overlay}"
		                         IsHitTestVisible="{Binding Overlay.IsBusy, FallbackValue=False, TargetNullValue=False}"
		                         Visibility="{Binding Overlay.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}" />

		<!-- Player Directory & List Full-screen Overlay -->
		<controls:PlayerListControl x:Name="PlayerListOverlay"
		                            Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="1"
		                            Panel.ZIndex="9998" Visibility="Collapsed" />

		<!-- Career & Match History Full-screen Overlay -->
		<controls:CareerControl x:Name="CareerOverlay"
		                        Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="1"
		                        Panel.ZIndex="9999" Visibility="Collapsed" />
	</Grid>
</UserControl>
