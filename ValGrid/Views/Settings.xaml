<UserControl
	x:Class="ValGrid.Views.Settings"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:p="clr-namespace:ValGrid.Properties"
	xmlns:viewmodels="clr-namespace:ValGrid.ViewModels"
	xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
	xmlns:controls="clr-namespace:ValGrid.Controls"
	d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
	d:DesignHeight="754"
	d:DesignWidth="1536"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
			<Border
				x:Name="Border"
				Background="#1b2033"
				BorderBrush="#333f63"
				BorderThickness="1"
				CornerRadius="8">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="28" />
					</Grid.ColumnDefinitions>
					<Path
						x:Name="Arrow"
						Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Data="M 0,0 L 4.5,4.5 L 9,0"
						Stroke="#8e9bb5"
						StrokeThickness="1.5"
						Fill="Transparent" />
				</Grid>
			</Border>
			<ControlTemplate.Triggers>
				<Trigger Property="IsMouseOver" Value="true">
					<Setter TargetName="Border" Property="BorderBrush" Value="#007EF9" />
					<Setter TargetName="Border" Property="Background" Value="#222a42" />
					<Setter TargetName="Arrow" Property="Stroke" Value="#007EF9" />
				</Trigger>
				<Trigger Property="IsChecked" Value="true">
					<Setter TargetName="Border" Property="BorderBrush" Value="#007EF9" />
					<Setter TargetName="Arrow" Property="Stroke" Value="#007EF9" />
				</Trigger>
			</ControlTemplate.Triggers>
		</ControlTemplate>

		<ControlTemplate x:Key="ComboBoxTextBox" TargetType="{x:Type TextBox}">
			<Border
				x:Name="PART_ContentHost"
				Background="{TemplateBinding Background}"
				Focusable="False" />
		</ControlTemplate>

		<Style TargetType="{x:Type ComboBox}">
			<Setter Property="SnapsToDevicePixels" Value="true" />
			<Setter Property="OverridesDefaultStyle" Value="true" />
			<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
			<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
			<Setter Property="ScrollViewer.CanContentScroll" Value="true" />
			<Setter Property="MinWidth" Value="110" />
			<Setter Property="MinHeight" Value="28" />
			<Setter Property="Height" Value="32" />
			<Setter Property="Foreground" Value="#f1f5f9" />
			<Setter Property="FontFamily" Value="{StaticResource Nunito}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ComboBox}">
						<Grid>
							<ToggleButton
								Name="ToggleButton"
								ClickMode="Press"
								Focusable="false"
								IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
								Template="{StaticResource ComboBoxToggleButton}" />
							<ContentPresenter
								Name="ContentSite"
								Margin="10,0,28,0"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="Center"
								Content="{TemplateBinding SelectionBoxItem}"
								ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
								ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
								IsHitTestVisible="False" />
							<TextBox
								x:Name="PART_EditableTextBox"
								Margin="10,0,28,0"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								FontFamily="{StaticResource Nunito}"
								Background="#1b2033"
								Focusable="True"
								Foreground="#f1f5f9"
								IsReadOnly="{TemplateBinding IsReadOnly}"
								Style="{x:Null}"
								Template="{StaticResource ComboBoxTextBox}"
								Visibility="Hidden" />
							<Popup
								Name="Popup"
								AllowsTransparency="True"
								Focusable="False"
								IsOpen="{TemplateBinding IsDropDownOpen}"
								Placement="Bottom"
								PopupAnimation="Fade">

								<Grid
									Name="DropDown"
									MinWidth="{TemplateBinding ActualWidth}"
									MaxHeight="{TemplateBinding MaxDropDownHeight}"
									SnapsToDevicePixels="True"
									Margin="0,4,0,4">
									<Border
										x:Name="DropDownBorder"
										Background="#151a2d"
										BorderBrush="#333f63"
										BorderThickness="1"
										CornerRadius="8">
										<Border.Effect>
											<DropShadowEffect BlurRadius="12" ShadowDepth="4" Color="Black" Opacity="0.5" />
										</Border.Effect>
									</Border>
									<ScrollViewer Margin="4" SnapsToDevicePixels="True">
										<StackPanel IsItemsHost="True"
										            KeyboardNavigation.DirectionalNavigation="Contained" />
									</ScrollViewer>
								</Grid>
							</Popup>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="HasItems" Value="false">
								<Setter TargetName="DropDownBorder" Property="MinHeight" Value="60" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="false">
								<Setter Property="Foreground" Value="#555555" />
							</Trigger>
							<Trigger Property="IsGrouping" Value="true">
								<Setter Property="ScrollViewer.CanContentScroll" Value="false" />
							</Trigger>
							<Trigger Property="IsEditable" Value="true">
								<Setter Property="IsTabStop" Value="false" />
								<Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
								<Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="{x:Type ComboBoxItem}">
			<Setter Property="SnapsToDevicePixels" Value="true" />
			<Setter Property="Foreground" Value="#cbd5e1" />
			<Setter Property="OverridesDefaultStyle" Value="true" />
			<Setter Property="FontFamily" Value="{StaticResource Nunito}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ComboBoxItem}">
						<Border
							Name="Border"
							Padding="8,6"
							Margin="2,1"
							CornerRadius="6"
							Background="Transparent"
							SnapsToDevicePixels="true">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsHighlighted" Value="true">
								<Setter TargetName="Border" Property="Background" Value="#252f4a" />
								<Setter Property="Foreground" Value="#38bdf8" />
							</Trigger>
							<Trigger Property="IsSelected" Value="true">
								<Setter TargetName="Border" Property="Background" Value="#1d263b" />
								<Setter Property="Foreground" Value="#ffd700" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="false">
								<Setter Property="Foreground" Value="#555555" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="VarChipBtnStyle" TargetType="Button">
			<Setter Property="Background" Value="#172236" />
			<Setter Property="BorderBrush" Value="#2b4066" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Foreground" Value="#7dd3fc" />
			<Setter Property="FontFamily" Value="{StaticResource Nunito}" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Margin" Value="0,0,5,3" />
			<Setter Property="Padding" Value="7,2" />
			<Setter Property="Height" Value="24" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#223554" />
					<Setter Property="BorderBrush" Value="#38bdf8" />
					<Setter Property="Foreground" Value="#ffffff" />
				</Trigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>
	<UserControl.Triggers>
		<EventTrigger RoutedEvent="Loaded">
			<BeginStoryboard>
				<Storyboard>
					<DoubleAnimation
						Storyboard.TargetProperty="Opacity"
						From="0.0" To="1.0" Duration="0:0:1" />
				</Storyboard>
			</BeginStoryboard>
		</EventTrigger>
	</UserControl.Triggers>


	<Grid Background="#2E3349" Margin="15">
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="60" />
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid Grid.ColumnSpan="3">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="60" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<fa:ImageAwesome PrimaryColor="#007EF9" Icon="Solid_Gear" Margin="10" />

			<Button
				x:Name="HomeNavBtn"
				Grid.Column="1" Cursor="Hand"
				Margin="25 0"
				Command="{Binding DataContext.NavigateHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				Template="{StaticResource ButtonTemplate}"
				ToolTipService.InitialShowDelay="0">

				<Viewbox
					Grid.Column="1"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
					<TextBlock
						x:Name="HomeNavBtnText"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						FontFamily="{StaticResource Nunito}"
						FontWeight="Medium"
						Foreground="#007EF9"
						Text="Ana Sayfa" />
				</Viewbox>
			</Button>

			<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
				<!-- Player Directory & List Button -->
				<Button x:Name="NavPlayerListBtn" Cursor="Hand" Height="50" Margin="0,0,10,0" Padding="14,0"
				        Click="OpenPlayerList_Click"
				        Template="{StaticResource ButtonTemplate}"
				        ToolTipService.InitialShowDelay="0">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<fa:ImageAwesome Icon="Solid_Users" PrimaryColor="#32e2b2" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
						<TextBlock x:Name="NavPlayerListText" Text="Liste" FontFamily="{StaticResource Nunito}" FontSize="16" FontWeight="Bold"
						           Foreground="#32e2b2" VerticalAlignment="Center" />
					</StackPanel>
				</Button>

				<Button x:Name="NavCareerBtn" Cursor="Hand" Height="50" Margin="0,0,10,0" Padding="14,0"
				        Click="OpenCareer_Click"
				        Template="{StaticResource ButtonTemplate}"
				        ToolTipService.InitialShowDelay="0">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<fa:ImageAwesome Icon="Solid_Scroll" PrimaryColor="#007EF9" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
						<TextBlock x:Name="NavCareerText" Text="Kariyer" FontFamily="{StaticResource Nunito}" FontSize="16" FontWeight="Bold"
						           Foreground="#007EF9" VerticalAlignment="Center" />
					</StackPanel>
				</Button>
				<Button x:Name="NavInfoBtn" Cursor="Hand" Width="60" Height="60"
				        Command="{Binding DataContext.NavigateInfoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				        Template="{StaticResource ButtonTemplate}"
				        ToolTipService.InitialShowDelay="0">
					<fa:ImageAwesome PrimaryColor="#007EF9" Icon="Solid_Info" Margin="10" />
				</Button>
			</StackPanel>
		</Grid>

		<Border
			Grid.Row="1"
			Grid.RowSpan="2"
			Grid.Column="0"
			Margin="0 25 25 25"
			Background="#252A40"
			CornerRadius="20">
			<Border.Effect>
				<DropShadowEffect BlurRadius="5" ShadowDepth="3" />
			</Border.Effect>
			<Grid VerticalAlignment="Center" Margin="14,10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!-- 1. Dil Secimi -->
				<TextBlock
					x:Name="SelectLanguageTitleText"
					Grid.Row="0"
					HorizontalAlignment="Center"
					FontWeight="DemiBold"
					FontFamily="{StaticResource Nunito}"
					FontSize="14"
					Foreground="White"
					Text="Dil Seçin"
					TextAlignment="Center"
					Margin="0,0,0,6" />
				<ComboBox
					Grid.Row="1"
					Name="LanguageCombo"
					x:FieldModifier="public"
					HorizontalContentAlignment="Center"
					Width="175"
					Height="30"
					HorizontalAlignment="Center"
					SelectionChanged="ListBox_SelectedAsync" />

				<!-- Ayirici Cizgi -->
				<Separator Grid.Row="2" Background="#333b5c" Height="1" Margin="10,10" />

				<!-- 2. Valorant Algilayici (Watcher) -->
				<StackPanel Grid.Row="3" HorizontalAlignment="Center">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
						<fa:ImageAwesome Icon="Solid_Eye" PrimaryColor="#32e2b2" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
						<TextBlock x:Name="WatcherTitleText" Text="Valorant İzleyici (Watcher)"
						           FontFamily="{StaticResource Nunito}" FontWeight="Bold" FontSize="13"
						           Foreground="White" VerticalAlignment="Center" />
					</StackPanel>
					<TextBlock x:Name="WatcherSubtitleText" Text="Valorant açıldığında ValGrid'ı otomatik başlatır"
					           FontFamily="{StaticResource Nunito}" FontSize="10.5" Foreground="#8e9bb5"
					           HorizontalAlignment="Center" Margin="0,3,0,8" TextAlignment="Center" />
				</StackPanel>

				<!-- Watcher Toggle Butonu -->
				<Button Grid.Row="4" x:Name="WatcherToggleButton"
				        Click="ToggleWatcher_Click"
				        Cursor="Hand" Height="30" Width="175" HorizontalAlignment="Center"
				        Background="#241920" BorderBrush="#64748b" BorderThickness="1.2">
					<Button.Resources>
						<Style TargetType="Border">
							<Setter Property="CornerRadius" Value="8" />
						</Style>
					</Button.Resources>
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
						<fa:ImageAwesome x:Name="WatcherToggleIcon" Icon="Solid_Xmark" PrimaryColor="#94a3b8" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center" />
						<TextBlock x:Name="WatcherToggleText" Text="İzleyici Kapalı"
						           FontFamily="{StaticResource Nunito}" FontSize="11.5" FontWeight="Bold" Foreground="#94a3b8" VerticalAlignment="Center" />
					</StackPanel>
				</Button>

				<!-- Durum Metni -->
				<TextBlock Grid.Row="5" x:Name="WatcherStatusText"
				           Text="İzleyici devre dışı"
				           FontFamily="{StaticResource Nunito}" FontSize="10" FontWeight="SemiBold"
				           Foreground="#64748b" HorizontalAlignment="Center" Margin="0,4,0,0" />
			</Grid>
		</Border>

		<Border
			Grid.Row="3"
			Grid.RowSpan="2"
			Grid.Column="0"
			Margin="0 25 25 0"
			Background="#252A40"
			CornerRadius="20">
			<Border.Effect>
				<DropShadowEffect BlurRadius="5" ShadowDepth="3" />
			</Border.Effect>
			<Grid Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<TextBlock
					x:Name="CheckDownloadTitleText"
					Grid.Row="0"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="26"
					FontWeight="DemiBold"
					FontFamily="{StaticResource Nunito}"
					Foreground="White"
					Text="İndirilen İçeriği Kontrol Et"
					TextWrapping="Wrap" />

				<StackPanel Grid.Row="1" Margin="8,6,8,4">
					<ProgressBar x:Name="DownloadProgressBar"
					             Height="4" IsIndeterminate="True"
					             Foreground="#32e2b2" Background="#181e34"
					             BorderThickness="0"
					             Visibility="Collapsed" Margin="0,0,0,4" />
					<TextBlock
						x:Name="DownloadStatusBox"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						FontSize="11"
						FontFamily="{StaticResource Nunito}"
						FontWeight="SemiBold"
						Foreground="#8e9bb5"
						Text=""
						TextAlignment="Center"
						TextWrapping="Wrap" />
				</StackPanel>

				<Viewbox Grid.Row="2" HorizontalAlignment="Center">
					<Button
						x:Name="ForceDownloadButton"
						Margin="6"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Click="Button_Click5Async"
						Template="{StaticResource ButtonTemplate}">
						<Viewbox>
							<TextBlock
								x:Name="ForceDownloadBtnText"
								Padding="5"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontFamily="{StaticResource Nunito}"
								FontWeight="Normal"
								Foreground="#007EF9"
								Text="Zorla Güncelle" />
						</Viewbox>
					</Button>
				</Viewbox>

				<Viewbox Grid.Row="3">
					<Button
						x:Name="CheckDownloadButton"
						Margin="6"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Click="Button_Click4Async"
						Template="{StaticResource ButtonTemplate}">
						<Viewbox>
							<TextBlock
								x:Name="CheckDownloadBtnText"
								Padding="5"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontFamily="{StaticResource Nunito}"
								FontWeight="Normal"
								Foreground="#007EF9"
								Text="Güncellemeleri Kontrol Et" />
						</Viewbox>
					</Button>
				</Viewbox>
			</Grid>
		</Border>

		<Border
			Grid.Row="1"
			Grid.RowSpan="2"
			Grid.Column="1"
			Margin="25"
			Background="#252A40"
			CornerRadius="20">
			<Border.Effect>
				<DropShadowEffect BlurRadius="5" ShadowDepth="3" />
			</Border.Effect>
			<Grid Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<TextBlock
					x:Name="InfoCardTitleText"
					Grid.Row="0"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="30"
					FontFamily="{StaticResource Nunito}"
					FontWeight="DemiBold"
					Foreground="White"
					Text="Bilgi"
					TextWrapping="Wrap" />
				<Viewbox Grid.Row="1" VerticalAlignment="Top">
					<TextBlock
						x:Name="InfoCardDesc1Text"
						Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
						Margin="25,0"
						Background="Transparent"
						FontSize="25"
						FontWeight="Light"
						FontFamily="{StaticResource Nunito}"
						Foreground="White"
						Opacity="0.7"
						Text="Bu sayfa manuel olarak giriş yapmanızı, uygulama dilini değiştirmenizi vb. sağlar."
						TextAlignment="Center"
						TextWrapping="Wrap" />
				</Viewbox>

				<Viewbox Grid.Row="2" VerticalAlignment="Top">
					<TextBlock
						x:Name="InfoCardDesc2Text"
						Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
						Margin="25,0"
						FontSize="25"
						FontWeight="Normal"
						Foreground="White"
						FontFamily="{StaticResource Nunito}"
						Opacity="0.2"
						Text="Giriş bilgilerinizle ilgili tüm iletişim doğrudan Riot sunucularıyla yapılır, parolalarınız yerel olarak veya çevrimiçi asla depolanmaz."
						TextAlignment="Center"
						TextWrapping="Wrap" />
				</Viewbox>
			</Grid>
		</Border>

		<Border
			Grid.Row="1"
			Grid.RowSpan="2"
			Grid.Column="2"
			Margin="25 25 0 25"
			Background="#252A40"
			CornerRadius="20">
			<Border.Effect>
				<DropShadowEffect BlurRadius="5" ShadowDepth="3" />
			</Border.Effect>
			<Grid Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>
				<TextBlock
					x:Name="AutoLoginTitleText"
					Grid.Row="0"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontFamily="{StaticResource Nunito}"
					FontSize="30"
					FontWeight="DemiBold"
					Foreground="White"
					Text="Otomatik Giriş"
					TextWrapping="Wrap" />
				<Viewbox Grid.Row="1" HorizontalAlignment="Center">
					<TextBlock
						x:Name="AutoLoginDescText"
						Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
						Margin="25,5"
						Background="Transparent"
						FontSize="25"
						FontFamily="{StaticResource Nunito}"
						FontWeight="Normal"
						Foreground="White"
						Opacity="0.7"
						Text="Not: Bunun çalışması için Valorant'ın açık olması gerekir"
						TextWrapping="Wrap" />
				</Viewbox>

				<Viewbox Grid.Row="2">
					<Button
						Margin="10"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Click="Button_Click3Async"
						Template="{StaticResource ButtonTemplate}">
						<Viewbox>
							<TextBlock
								x:Name="AutoLoginBtnText"
								Padding="5"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontWeight="Normal"
								FontFamily="{StaticResource Nunito}"
								Foreground="#007EF9"
								Text="Giriş Yap" />
						</Viewbox>
					</Button>
				</Viewbox>
			</Grid>
		</Border>

		<Border Grid.Row="3"
		        Grid.RowSpan="2"
		        Grid.Column="2"
		        Margin="25 25 0 0"
		        Background="#252A40"
		        CornerRadius="20">
			<Border.Effect>
				<DropShadowEffect BlurRadius="5" ShadowDepth="3" />
			</Border.Effect>
			<Grid Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>
				<TextBlock
					x:Name="AppUpdatesTitleText"
					Grid.Row="0"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="30"
					FontFamily="{StaticResource Nunito}"
					FontWeight="DemiBold"
					Foreground="White"
					Text="Uygulama Güncellemeleri"
					TextWrapping="Wrap" />

				<StackPanel Grid.Row="1">
					<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
						<TextBlock
							x:Name="LatestVersionLabelText"
							FontSize="20"
							FontFamily="{StaticResource Nunito}"
							Foreground="White"
							Opacity="0.7"
							Text="En Son Sürüm: "
							TextAlignment="Left"
							TextWrapping="Wrap" />
						<TextBlock
							x:Name="LatestVersion"
