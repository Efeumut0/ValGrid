									</StackPanel>
									<Button Grid.Column="1" Click="ClearBlacklist_Click"
									        Background="#241520" BorderBrush="#e55b5b" BorderThickness="1"
									        Cursor="Hand" Padding="12,5" Height="28" VerticalAlignment="Center">
										<Button.Resources>
											<Style TargetType="Border">
												<Setter Property="CornerRadius" Value="6" />
											</Style>
										</Button.Resources>
										<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
											<fa:ImageAwesome Icon="Solid_TrashCan" PrimaryColor="#e55b5b" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center" />
											<TextBlock x:Name="ModalCat5BtnText" Text="Temizle" FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="Bold" Foreground="#e55b5b" VerticalAlignment="Center" />
										</StackPanel>
									</Button>
								</Grid>
							</Border>
						</StackPanel>

						<!-- Modal Feedback Text -->
						<TextBlock x:Name="ModalStatusText" Text="" FontFamily="{StaticResource Nunito}"
						           FontSize="12" FontWeight="Bold" Foreground="#32e2b2" HorizontalAlignment="Center"
						           Margin="0,0,0,12" Visibility="Collapsed" />

						<!-- Modal Footer Actions -->
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Button Grid.Column="0" Click="ClearAllPlayerData_Click"
							        Background="#30151a" BorderBrush="#ef4444" BorderThickness="1.2"
							        Cursor="Hand" Height="34" Padding="14,0" HorizontalAlignment="Left">
								<Button.Resources>
									<Style TargetType="Border">
										<Setter Property="CornerRadius" Value="8" />
									</Style>
								</Button.Resources>
								<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
									<fa:ImageAwesome Icon="Solid_TriangleExclamation" PrimaryColor="#f87171" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
									<TextBlock x:Name="ModalClearAllBtnText" Text="Tüm Oyuncu Verilerini Temizle" FontFamily="{StaticResource Nunito}"
									           FontWeight="Bold" FontSize="11.5" Foreground="#f87171" VerticalAlignment="Center" />
								</StackPanel>
							</Button>

							<Button Grid.Column="1" Click="ClosePlayerDataModal_Click"
							        Background="#1e263d" BorderBrush="#3c476d" BorderThickness="1.2"
							        Cursor="Hand" Height="34" Padding="18,0">
								<Button.Resources>
									<Style TargetType="Border">
										<Setter Property="CornerRadius" Value="8" />
									</Style>
								</Button.Resources>
								<TextBlock x:Name="ModalCloseBtnText" Text="Kapat" FontFamily="{StaticResource Nunito}"
								           FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
							</Button>
						</Grid>
					</StackPanel>
				</Border>
			</Grid>
		</Grid>

		<!-- Chat Templates Management Modal Overlay -->
		<Grid x:Name="ChatTemplatesModal" Grid.Row="0" Grid.Column="0" Grid.RowSpan="6" Grid.ColumnSpan="3"
		      Panel.ZIndex="10001" Visibility="Collapsed" Background="#b0090d18"
		      MouseLeftButtonUp="ChatTemplatesModal_BackdropClick">
			<Grid HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonUp="ChatTemplatesModal_InnerClick">
				<Border Width="680" MaxHeight="680" Background="#161c2e" CornerRadius="18" Padding="22"
				        BorderBrush="#2e3d66" BorderThickness="1.5">
					<Border.Effect>
						<DropShadowEffect BlurRadius="28" ShadowDepth="8" Color="Black" Opacity="0.85" />
					</Border.Effect>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!-- Modal Header -->
						<Grid Grid.Row="0" Margin="0,0,0,14">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0">
								<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
									<fa:ImageAwesome Icon="Solid_CommentDots" PrimaryColor="#38bdf8" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
									<TextBlock x:Name="ChatTemplatesModalTitleText" Text="Chat Mesaj Şablonları" FontFamily="{StaticResource Nunito}"
									           FontSize="18" FontWeight="ExtraBold" Foreground="White" VerticalAlignment="Center" />
								</StackPanel>
								<TextBlock x:Name="ChatTemplatesModalSubtitleText" Text="Maç içinde panoya (Ctrl+V) kopyalanan mesajları özelleştirin. Değişken butonlarına tıklayarak şablona ekleyebilirsiniz."
								           FontFamily="{StaticResource Nunito}" FontSize="12" Foreground="#8e9bb5" Margin="0,4,0,0" TextWrapping="Wrap" />
							</StackPanel>
							<Button Grid.Column="1" Click="CloseChatTemplatesModal_Click"
							        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6" VerticalAlignment="Top">
								<TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="#94a3b8" />
							</Button>
						</Grid>

						<!-- Scrollable Templates Content -->
						<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12" Padding="0,0,6,0">
							<StackPanel>
								<!-- 1. Maç Başlangıç Mesajı Card -->
								<Border Background="#101524" CornerRadius="12" Padding="14,12" Margin="0,0,0,10"
								        BorderBrush="#1e2740" BorderThickness="1">
									<StackPanel>
										<Grid Margin="0,0,0,8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
												<fa:ImageAwesome Icon="Solid_Play" PrimaryColor="#34d399" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
												<TextBlock x:Name="TplMatchStartTitleText" Text="Maç Başlangıcı (Sağ Tık / Kopyalama)" FontFamily="{StaticResource Nunito}"
												           FontSize="13" FontWeight="Bold" Foreground="#34d399" VerticalAlignment="Center" />
											</StackPanel>
											<TextBlock Grid.Column="1" Text="Ctrl+V Maç Başı" FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="SemiBold" Foreground="#64748b" />
										</Grid>

										<!-- TextBox -->
										<TextBox x:Name="TplMatchStartBox" TextWrapping="Wrap" AcceptsReturn="False" Height="52"
										         Background="#182035" Foreground="#f1f5f9" BorderBrush="#2e3d66" BorderThickness="1"
										         FontFamily="{StaticResource Nunito}" FontSize="12" Padding="8,6"
										         TextChanged="TplMatchStartBox_TextChanged" />

										<!-- Variable Chips -->
										<WrapPanel Margin="0,6,0,6">
											<TextBlock x:Name="TplInsertVar1Text" Text="Değişken Ekle:" FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,6,0" />
											<Button Click="InsertVarStart_Click" Tag="{}{totalVp}" Content="{}{totalVp}" ToolTip="Toplam VP Değeri" Style="{StaticResource VarChipBtnStyle}" />
											<Button Click="InsertVarStart_Click" Tag="{}{totalTl}" Content="{}{totalTl}" ToolTip="Toplam Yaklaşık TL Değeri" Style="{StaticResource VarChipBtnStyle}" />
											<Button Click="InsertVarStart_Click" Tag="{}{richest}" Content="{}{richest}" ToolTip="En zenginler hazır özeti" Style="{StaticResource VarChipBtnStyle}" />
											<Button Click="InsertVarStart_Click" Tag="{}{richest1}" Content="{}{richest1}" ToolTip="1. En Zengin Oyuncu" Style="{StaticResource VarChipBtnStyle}" />
											<Button Click="InsertVarStart_Click" Tag="{}{richest2}" Content="{}{richest2}" ToolTip="2. En Zengin Oyuncu" Style="{StaticResource VarChipBtnStyle}" />
										</WrapPanel>

										<!-- Live Preview -->
										<Border Background="#0d111d" CornerRadius="8" Padding="10,6" BorderBrush="#162035" BorderThickness="1">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<TextBlock Text="Önizleme: " FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="Bold" Foreground="#34d399" VerticalAlignment="Top" />
												<TextBlock x:Name="TplMatchStartPreviewText" Grid.Column="1" Text="" FontFamily="{StaticResource Nunito}" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap" />
											</Grid>
										</Border>
									</StackPanel>
								</Border>

								<!-- 2. Maç Sonu Mesajı Card -->
								<Border Background="#101524" CornerRadius="12" Padding="14,12" Margin="0,0,0,10"
								        BorderBrush="#1e2740" BorderThickness="1">
									<StackPanel>
										<Grid Margin="0,0,0,8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
												<fa:ImageAwesome Icon="Solid_FlagCheckered" PrimaryColor="#f59e0b" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
												<TextBlock x:Name="TplMatchEndTitleText" Text="Maç Sonu (Sol Tık / Standart Kopyalama)" FontFamily="{StaticResource Nunito}"
												           FontSize="13" FontWeight="Bold" Foreground="#f59e0b" VerticalAlignment="Center" />
											</StackPanel>
											<TextBlock Grid.Column="1" Text="Ctrl+V Maç Sonu" FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="SemiBold" Foreground="#64748b" />
										</Grid>

										<!-- TextBox -->
										<TextBox x:Name="TplMatchEndBox" TextWrapping="Wrap" AcceptsReturn="False" Height="52"
										         Background="#182035" Foreground="#f1f5f9" BorderBrush="#2e3d66" BorderThickness="1"
										         FontFamily="{StaticResource Nunito}" FontSize="12" Padding="8,6"
										         TextChanged="TplMatchEndBox_TextChanged" />

										<!-- Variable Chips -->
										<WrapPanel Margin="0,6,0,6">
											<TextBlock x:Name="TplInsertVar2Text" Text="Değişken Ekle:" FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,6,0" />
											<Button Click="InsertVarEnd_Click" Tag="{}{totalVp}" Content="{}{totalVp}" ToolTip="Toplam VP Değeri" Style="{StaticResource VarChipBtnStyle}" />
											<Button Click="InsertVarEnd_Click" Tag="{}{totalTl}" Content="{}{totalTl}" ToolTip="Toplam Yaklaşık TL Değeri" Style="{StaticResource VarChipBtnStyle}" />
											<Button Click="InsertVarEnd_Click" Tag="{}{richest}" Content="{}{richest}" ToolTip="En zenginler hazır özeti" Style="{StaticResource VarChipBtnStyle}" />
											<Button Click="InsertVarEnd_Click" Tag="{}{blacklist}" Content="{}{blacklist}" ToolTip="Kara listedeki oyuncuların anonsu" Style="{StaticResource VarChipBtnStyle}" />
										</WrapPanel>

										<!-- Live Preview -->
										<Border Background="#0d111d" CornerRadius="8" Padding="10,6" BorderBrush="#162035" BorderThickness="1">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<TextBlock Text="Önizleme: " FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="Bold" Foreground="#f59e0b" VerticalAlignment="Top" />
												<TextBlock x:Name="TplMatchEndPreviewText" Grid.Column="1" Text="" FontFamily="{StaticResource Nunito}" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap" />
											</Grid>
										</Border>
									</StackPanel>
								</Border>

								<!-- 3. Liderlik / Sıralama Mesajı Card -->
								<Border Background="#101524" CornerRadius="12" Padding="14,12" Margin="0,0,0,0"
								        BorderBrush="#1e2740" BorderThickness="1">
									<StackPanel>
										<Grid Margin="0,0,0,8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
												<fa:ImageAwesome Icon="Solid_Trophy" PrimaryColor="#38bdf8" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
												<TextBlock x:Name="TplLeaderboardTitleText" Text="Liderlik Sıralaması (Kupa / Sıralama Kopyalama)" FontFamily="{StaticResource Nunito}"
												           FontSize="13" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center" />
											</StackPanel>
											<TextBlock Grid.Column="1" Text="Ctrl+V Sıralama" FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="SemiBold" Foreground="#64748b" />
										</Grid>

										<!-- TextBox -->
										<TextBox x:Name="TplLeaderboardBox" TextWrapping="Wrap" AcceptsReturn="False" Height="36"
										         Background="#182035" Foreground="#f1f5f9" BorderBrush="#2e3d66" BorderThickness="1"
										         FontFamily="{StaticResource Nunito}" FontSize="12" Padding="8,6"
										         TextChanged="TplLeaderboardBox_TextChanged" />

										<!-- Variable Chips -->
										<WrapPanel Margin="0,6,0,6">
											<TextBlock x:Name="TplInsertVar3Text" Text="Değişken Ekle:" FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,6,0" />
											<Button Click="InsertVarLeaderboard_Click" Tag="{}{leaderboard}" Content="{}{leaderboard}" ToolTip="Tek satır sıralı oyuncular" Style="{StaticResource VarChipBtnStyle}" />
										</WrapPanel>

										<!-- Live Preview -->
										<Border Background="#0d111d" CornerRadius="8" Padding="10,6" BorderBrush="#162035" BorderThickness="1">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<TextBlock Text="Önizleme: " FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Top" />
												<TextBlock x:Name="TplLeaderboardPreviewText" Grid.Column="1" Text="" FontFamily="{StaticResource Nunito}" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap" />
											</Grid>
										</Border>
									</StackPanel>
								</Border>
							</StackPanel>
						</ScrollViewer>

						<!-- Modal Footer Actions -->
						<Grid Grid.Row="2">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<!-- Reset Defaults Button -->
							<Button Grid.Column="0" Click="ResetChatTemplates_Click"
							        Background="#241520" BorderBrush="#e55b5b" BorderThickness="1.2"
							        Cursor="Hand" Height="34" Padding="12,0" HorizontalAlignment="Left">
								<Button.Resources>
									<Style TargetType="Border">
										<Setter Property="CornerRadius" Value="8" />
									</Style>
								</Button.Resources>
								<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
									<fa:ImageAwesome Icon="Solid_RotateLeft" PrimaryColor="#e55b5b" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center" />
									<TextBlock x:Name="TplResetBtnText" Text="Varsayılana Sıfırla" FontFamily="{StaticResource Nunito}"
									           FontWeight="Bold" FontSize="11.5" Foreground="#e55b5b" VerticalAlignment="Center" />
								</StackPanel>
							</Button>

							<!-- Feedback Status -->
							<TextBlock x:Name="TplStatusText" Grid.Column="1" Text="" FontFamily="{StaticResource Nunito}"
							           FontSize="12" FontWeight="Bold" Foreground="#32e2b2" HorizontalAlignment="Center"
							           VerticalAlignment="Center" Margin="8,0" Visibility="Collapsed" />

							<!-- Save & Close Buttons -->
							<StackPanel Grid.Column="2" Orientation="Horizontal">
								<Button Click="SaveChatTemplates_Click"
								        Background="#183628" BorderBrush="#10b981" BorderThickness="1.2"
								        Cursor="Hand" Height="34" Padding="14,0" Margin="0,0,8,0">
									<Button.Resources>
										<Style TargetType="Border">
											<Setter Property="CornerRadius" Value="8" />
										</Style>
									</Button.Resources>
									<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
										<fa:ImageAwesome Icon="Solid_FloppyDisk" PrimaryColor="#34d399" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
										<TextBlock x:Name="TplSaveBtnText" Text="Kaydet" FontFamily="{StaticResource Nunito}"
										           FontWeight="Bold" FontSize="12" Foreground="#34d399" VerticalAlignment="Center" />
									</StackPanel>
								</Button>

								<Button Click="CloseChatTemplatesModal_Click"
								        Background="#1e263d" BorderBrush="#3c476d" BorderThickness="1.2"
								        Cursor="Hand" Height="34" Padding="16,0">
									<Button.Resources>
										<Style TargetType="Border">
											<Setter Property="CornerRadius" Value="8" />
										</Style>
									</Button.Resources>
									<TextBlock x:Name="TplCloseBtnText" Text="Kapat" FontFamily="{StaticResource Nunito}"
									           FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
								</Button>
							</StackPanel>
						</Grid>
					</Grid>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
