<UserControl x:Class="ValGrid.Controls.SkinInspectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.fontawesome.com/icons/fonts" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1400"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Background="Transparent">

    <UserControl.Resources>
        <FontFamily x:Key="Nunito">/Assets/#Nunito</FontFamily>

        <!-- Modern Button Style -->
        <Style x:Key="InspectActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource Nunito}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Video Seek Slider Style -->
        <Style x:Key="VideoSeekSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="22" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#38bdf8" Height="4" CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#334155" Height="4" CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Width="12" Height="12" Fill="#38bdf8" Stroke="White" StrokeThickness="1.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#38bdf8" Opacity="0.85" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Outer Dimmed Backdrop (Captures clicks so background never gets clicked) -->
    <Grid>
        <Border Background="#E6070912" PreviewMouseDown="Backdrop_MouseDown" />

        <!-- Main Modal Window -->
        <Border x:Name="ModalBorder" Margin="24,14" MaxWidth="1280" MaxHeight="780"
                Background="#0e1322" CornerRadius="18"
                BorderBrush="#25324d" BorderThickness="1.5"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                PreviewMouseDown="ModalBorder_PreviewMouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="10" Color="Black" Opacity="0.8" />
            </Border.Effect>

            <Grid Margin="24,18,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderRowDef" Height="Auto" />  <!-- 0: Header -->
                    <RowDefinition Height="*" />                            <!-- 1: Video / Image Player -->
                    <RowDefinition x:Name="FooterRowDef" Height="Auto" />  <!-- 2: Levels & Variants Controls -->
                </Grid.RowDefinitions>

                <!-- HEADER ROW -->
                <Grid x:Name="HeaderRowGrid" Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Tier Icon, Weapon Type, Skin Name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tier Badge / Icon -->
                        <Border x:Name="TierBadgeBorder" Width="44" Height="44" CornerRadius="10"
                                Background="#1a233a" BorderBrush="#ffd700" BorderThickness="1.2"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                            <Image x:Name="TierIconImage" Stretch="Uniform" Margin="6"
                                   RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <!-- Weapon Type Tag -->
                                <Border Background="#1b233a" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock x:Name="WeaponTypeTxt" Text="VANDAL" FontFamily="{StaticResource Nunito}"
                                               FontSize="11" FontWeight="Bold" Foreground="#38bdf8" />
                                </Border>
                                <!-- Tier Display Name -->
                                <TextBlock x:Name="TierNameTxt" Text="ULTRA SERİ" FontFamily="{StaticResource Nunito}"
                                           FontSize="11.5" FontWeight="ExtraBold" Foreground="#ffd700"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Skin Display Name -->
                            <TextBlock x:Name="SkinNameTxt" Text="Kuronami Vandal" FontFamily="{StaticResource Nunito}"
                                       FontSize="23" FontWeight="Bold" Foreground="White" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Price Badge & Close Button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Bundle Discount Pill (if part of bundle with discount) -->
                        <Border x:Name="BundleDiscountPill" Margin="0,0,10,0" Padding="10,5" CornerRadius="8"
                                Background="#14532d" BorderBrush="#22c55e" BorderThickness="1.2"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <fa:ImageAwesome Icon="Solid_Tag" PrimaryColor="#4ade80" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="BundleDiscountTxt" Text="Paket İçi: 3.531 VP (-34%)" FontFamily="{StaticResource Nunito}"
                                           FontSize="12" FontWeight="Bold" Foreground="#4ade80"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Standalone Price Badge -->
                        <Border Margin="0,0,14,0" Padding="12,6" CornerRadius="8"
                                Background="#161e31" BorderBrush="#ffd700" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image x:Name="VpIconImg" Width="18" Height="18" Margin="0,0,7,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="PriceVpTxt" Text="2.475 VP" FontFamily="{StaticResource Nunito}"
                                           FontSize="14" FontWeight="Bold" Foreground="#ffd700"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="PriceTlTxt" Text="(~705 TL)" FontFamily="{StaticResource Nunito}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#94a3b8"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Close Button -->
                        <Button x:Name="InspectCloseBtn" Click="Close_Click" Width="38" Height="38" Padding="0"
                                Background="#26151a" BorderBrush="#ef4444" BorderThickness="1"
                                Cursor="Hand" Style="{StaticResource InspectActionButton}" ToolTip="Kapat (ESC)">
                            <TextBlock Text="✕" FontSize="15" FontWeight="Bold" Foreground="#f87171"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 1: MAIN PREVIEW / VIDEO PLAYER AREA -->
                <Border Grid.Row="1" Background="#060911" CornerRadius="14"
                        BorderBrush="#1c253d" BorderThickness="1.2" ClipToBounds="True"
                        MouseLeftButtonDown="VideoArea_MouseLeftButtonDown">
                    <Grid>
                        <!-- Fallback / Static Skin Image -->
                        <Image x:Name="StaticImage" Stretch="Uniform" Margin="40"
                               RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Video Player (MediaElement) -->
                        <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                      ScrubbingEnabled="True" Stretch="Uniform"
                                      MediaOpened="VideoPlayer_MediaOpened"
                                      MediaEnded="VideoPlayer_MediaEnded"
                                      MediaFailed="VideoPlayer_MediaFailed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Loading Indicator for Video -->
                        <Border x:Name="VideoLoadingOverlay" Background="#90070912" Visibility="Collapsed"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <fa:ImageAwesome Icon="Solid_Hourglass" PrimaryColor="#38bdf8" Width="34" Height="34" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock x:Name="VideoLoadingText" Text="Tanıtım Videosu Yükleniyor..." FontFamily="{StaticResource Nunito}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#cbd5e1" />
                            </StackPanel>
                        </Border>

                        <!-- Central Seek Flash Notification Badge (e.g. +5 sn / -5 sn) -->
                        <Border x:Name="SeekFlashBadge" Background="#D90b1120" CornerRadius="14"
                                BorderBrush="#38bdf8" BorderThickness="1.8" Padding="20,12"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="Black" Opacity="0.8" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <fa:ImageAwesome x:Name="SeekFlashIcon" Icon="Solid_Forward" PrimaryColor="#38bdf8" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="SeekFlashText" Text="+5 sn (00:08)" FontFamily="{StaticResource Nunito}"
                                           FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Bottom Floating Video Controls Overlay (HIDDEN for 1-level skins without video) -->
                        <Border x:Name="VideoControlsBorder" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="16,0,16,14"
                                Background="#E00d1322" CornerRadius="12" BorderBrush="#263452" BorderThickness="1"
                                Padding="12,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />  <!-- Timeline Slider Row -->
                                    <RowDefinition Height="Auto" />  <!-- Buttons & Info Row -->
                                </Grid.RowDefinitions>

                                <!-- 0: Video Timeline Slider with IsMoveToPointEnabled="True" -->
                                <Slider x:Name="TimelineSlider" Grid.Row="0" Margin="0,0,0,6"
                                        SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True"
                                        Style="{StaticResource VideoSeekSlider}"
                                        PreviewMouseLeftButtonDown="TimelineSlider_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="TimelineSlider_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp"
                                        ValueChanged="TimelineSlider_ValueChanged" />

                                <!-- 1: Action Controls & Info -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Playback & Seek Buttons -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Seek -5s Button -->
                                        <Button x:Name="SeekBackwardBtn" Click="SeekBackwardBtn_Click" Padding="8,5" Margin="0,0,6,0"
                                                Background="#1c243a" BorderBrush="#35466d" BorderThickness="1"
                                                Cursor="Hand" ToolTip="5 Saniye Geri (Sol Ok ←)" Style="{StaticResource InspectActionButton}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <fa:ImageAwesome Icon="Solid_Backward" PrimaryColor="#38bdf8" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="-5s" FontSize="11.5" FontWeight="Bold" Foreground="#cbd5e1" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Play/Pause Button -->
                                        <Button x:Name="PlayPauseBtn" Click="PlayPauseBtn_Click" Padding="10,5" Margin="0,0,6,0"
                                                Background="#1c243a" BorderBrush="#35466d" BorderThickness="1"
                                                Cursor="Hand" ToolTip="Durdur / Oynat (Boşluk)" Style="{StaticResource InspectActionButton}">
                                            <fa:ImageAwesome x:Name="PlayPauseIcon" Icon="Solid_Pause" PrimaryColor="White" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Seek +5s Button -->
                                        <Button x:Name="SeekForwardBtn" Click="SeekForwardBtn_Click" Padding="8,5" Margin="0,0,6,0"
                                                Background="#1c243a" BorderBrush="#35466d" BorderThickness="1"
                                                Cursor="Hand" ToolTip="5 Saniye İleri (Sağ Ok →)" Style="{StaticResource InspectActionButton}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="+5s" FontSize="11.5" FontWeight="Bold" Foreground="#cbd5e1" VerticalAlignment="Center" />
                                                <fa:ImageAwesome Icon="Solid_Forward" PrimaryColor="#38bdf8" Width="11" Height="11" Margin="5,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Replay Button -->
                                        <Button x:Name="ReplayBtn" Click="ReplayBtn_Click" Padding="8,5" Margin="0,0,8,0"
                                                Background="#1c243a" BorderBrush="#35466d" BorderThickness="1"
                                                Cursor="Hand" ToolTip="Başa Sar (R)" Style="{StaticResource InspectActionButton}">
                                            <fa:ImageAwesome Icon="Solid_Rotate" PrimaryColor="#38bdf8" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Timestamp Text -->
                                        <TextBlock x:Name="TimeText" Text="00:00 / 00:00" FontFamily="{StaticResource Nunito}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#94a3b8"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>

                                    <!-- Center: Shortcuts Hint -->
                                    <TextBlock x:Name="ShortcutsHintText" Grid.Column="1" Text="← 5s Geri | → 5s İleri | Boşluk: Oynat | F: Tam Ekran | 1-5: Seviyeler"
                                               FontFamily="{StaticResource Nunito}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#64748b" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- Right: Audio & Fullscreen Controls -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Mute/Unmute Button -->
                                        <Button x:Name="MuteBtn" Click="MuteBtn_Click" Padding="9,5" Margin="0,0,6,0"
                                                Background="#1c243a" BorderBrush="#35466d" BorderThickness="1"
                                                Cursor="Hand" ToolTip="Sesi Aç / Kapat (M)" Style="{StaticResource InspectActionButton}">
                                            <fa:ImageAwesome x:Name="MuteIcon" Icon="Solid_VolumeHigh" PrimaryColor="White" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Fullscreen Toggle Button -->
                                        <Button x:Name="FullscreenBtn" Click="FullscreenBtn_Click" Padding="9,5"
                                                Background="#1c243a" BorderBrush="#35466d" BorderThickness="1"
                                                Cursor="Hand" ToolTip="Tam Ekran (F / F11 / Çift Tıklama)" Style="{StaticResource InspectActionButton}">
                                            <fa:ImageAwesome x:Name="FullscreenIcon" Icon="Solid_Expand" PrimaryColor="#38bdf8" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Top-Left Active Level/Chroma Badge -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,14,0,0"
                                Background="#BF0d1322" CornerRadius="8" BorderBrush="#263452" BorderThickness="1"
                                Padding="10,5">
                            <TextBlock x:Name="CurrentPlayingLabel" Text="Tanıtım Önizlemesi"
                                       FontFamily="{StaticResource Nunito}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#e2e8f0" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 2: LEVELS & VARIANTS CONTROLS (RESPONSIVE STACKPANEL - NEVER OVERLAPS) -->
                <StackPanel x:Name="FooterRowGrid" Grid.Row="2" Margin="0,12,0,0">
                    <!-- Section A: Levels Selector (Seviyeler) -->
                    <Border x:Name="LevelsSectionBorder" Margin="0,0,0,6" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LevelsSectionTitle" Text="SEVİYELER:" FontFamily="{StaticResource Nunito}" FontSize="11.5"
                                       FontWeight="ExtraBold" Foreground="#94a3b8" VerticalAlignment="Center"
                                       Margin="0,0,12,0" />

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl x:Name="LevelsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,8,0" Click="LevelBtn_Click" Cursor="Hand"
                                                    Style="{StaticResource InspectActionButton}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="LvlBorder" Background="#141c2e" CornerRadius="8"
                                                                BorderBrush="#2d3b5c" BorderThickness="1.2" Padding="12,7">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <fa:ImageAwesome Icon="Solid_Film" PrimaryColor="#38bdf8" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding LevelTypeName}" FontFamily="{StaticResource Nunito}"
                                                                           FontSize="12" FontWeight="Bold" Foreground="#e2e8f0"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="LvlBorder" Property="Background" Value="#223050" />
                                                                <Setter TargetName="LvlBorder" Property="BorderBrush" Value="#38bdf8" />
                                                                <Setter TargetName="LvlBorder" Property="BorderThickness" Value="1.6" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="LvlBorder" Property="Opacity" Value="0.88" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Section B: Variants / Chromas Selector (Varyantlar) -->
                    <Border x:Name="ChromasSectionBorder" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ChromasSectionTitle" Text="VARYANTLAR:" FontFamily="{StaticResource Nunito}" FontSize="11.5"
                                       FontWeight="ExtraBold" Foreground="#94a3b8" VerticalAlignment="Center"
                                       Margin="0,0,12,0" />

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl x:Name="ChromasList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,8,0" Click="ChromaBtn_Click" Cursor="Hand"
                                                    ToolTip="{Binding CleanStyleName}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ChrBorder" Width="36" Height="36" CornerRadius="18"
                                                                Background="#161e31" BorderBrush="#334155" BorderThickness="1.8"
                                                                Padding="2">
                                                            <Grid>
                                                                <Ellipse>
                                                                    <Ellipse.Fill>
                                                                        <ImageBrush ImageSource="{Binding SwatchUrl}" Stretch="UniformToFill" />
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="ChrBorder" Property="BorderBrush" Value="#ffd700" />
                                                                <Setter TargetName="ChrBorder" Property="BorderThickness" Value="2.5" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ChrBorder" Property="Opacity" Value="0.85" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Section C: Unupgradable Info Pill (shown when skin has no video/upgrades) -->
                    <Border x:Name="UnupgradableInfoBorder" Visibility="Collapsed" HorizontalAlignment="Center"
                            Background="#141c2e" CornerRadius="8" Padding="16,6" BorderBrush="#25324d" BorderThickness="1">
                        <TextBlock x:Name="UnupgradableText" Text="Standart Model • Yükseltme ve Tanıtım Videosu Bulunmuyor" FontFamily="{StaticResource Nunito}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#64748b" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

